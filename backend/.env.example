# Servidor
NODE_ENV=development
PORT=3000

# Base de datos PostgreSQL (compatible con Render DATABASE_URL)
DATABASE_URL=postgres://lucytejada:lucytejada_dev_password@localhost:5432/lucytejada_gea
DB_SSL=false
DB_SYNCHRONIZE=true
AUTO_SEED=true

# Redis (opcional: si no se define, usa caché en memoria + worker en proceso por táctica de degradación controlada)
# REDIS_URL=redis://localhost:6379

# Seguridad JWT
JWT_SECRET=cambiar_este_secreto_en_produccion_lucy_tejada_2026
JWT_REFRESH_SECRET=cambiar_este_refresh_secreto_en_produccion_lucy_tejada_2026
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS (orígenes permitidos separados por coma)
CORS_ORIGIN=http://localhost:5173,http://localhost:8080

# Correo SMTP (opcional: si no se define, usa MockMailAdapter guardando en bandeja interna)
# SMTP_HOST=localhost
# SMTP_PORT=1025
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="Centro Cultural Lucy Tejada <no-reply@lucytejada.pereira.gov.co>"

# Umbral algorítmico de deserción (número de inasistencias consecutivas)
DESERTION_ABSENCE_THRESHOLD=3
